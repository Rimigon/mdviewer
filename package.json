{
  "name": "mdviewer",
  "version": "0.1.0",
  "description": "Красивый просмотрщик Markdown в стиле GitHub",
  "main": "./out/main/index.js",
  "private": true,
  "build": {
    "appId": "com.mdviewer.app",
    "productName": "MD Viewer",
    "directories": { "output": "dist" },
    "files": ["out/**"],
    "win": {
      "target": ["nsis"],
      "fileAssociations": [
        { "ext": "md", "name": "Markdown Document", "description": "Markdown файл", "role": "Editor" }
      ]
    },
    "nsis": { "oneClick": false, "allowToChangeInstallationDirectory": true }
  },
  "scripts": {
    "dev": "electron-vite dev",
    "start": "electron-vite preview",
    "build": "electron-vite build",
    "build:win": "electron-vite build && electron-builder --win",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "register-assoc": "node scripts/register-assoc.mjs",
    "unregister-assoc": "node scripts/unregister-assoc.mjs"
  },
  "dependencies": {
    "github-markdown-css": "^5.9.0",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/jsdom": "^28.0.3",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "electron": "^43.3.0",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "jsdom": "^30.0.1",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^4.1.10"
  }
}
